@startuml
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam defaultFontSize 18

title Terraform, Cluster & CI/CD

component "GitHub Actions\nBuild image + check Terraform" as ci #EAF2FF
artifact "Docker Hub\nFrontend image" as registry #EAF2FF
component "Terraform\ncluster/ + terraform/" as tf #F0E8FF
component "Kubernetes YAML\nk8s/" as manifests #FFF3DA

node "Local Kubernetes cluster (kind)" as cluster #EAF7EE {
  node "1 control plane + 3 workers" as nodes
  component "Kubernetes resources\nDeployments, Services\nTraffic routing, Autoscaler" as resources
}

ci --> registry : builds & publishes
ci ..> tf : validates terraform/
tf --> cluster : creates (manual apply)
tf --> resources : configures (manual apply)
manifests --> resources : alternative: apply YAML manually
registry --> resources : image pulled at pod startup

note bottom of ci
  CI publishes images and validates Terraform.
  Cluster deployment is manual.
end note
@enduml

